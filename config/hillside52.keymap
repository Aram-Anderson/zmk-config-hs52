/*
 * Hillside 52 keymap.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
        keymap {
                compatible = "zmk,keymap";

                base_layer {
                        display-name = "Base";
                        bindings = <
&kp TAB              &kp Q                &kp W                &kp E                &kp R                &kp T                &kp Y                &kp U                &kp I                &kp O                &kp P                &kp MINUS
&kp ESC              &kp A                &kp S                &kp D                &kp F                &kp G                &kp H                &kp J                &kp K                &kp L                &kp SEMI             &kp SQT
&kp LSHFT            &kp Z                &kp X                &kp C                &kp V                &kp B                &kp C_VOL_DN         &kp C_VOL_UP         &kp N                &kp M                &kp COMMA            &kp DOT              &kp SLASH            &kp EQUAL
&mo 1                &mo 2                &kp BSLH             &kp LCTRL            &kp LALT             &kp BSPC             &kp LGUI             &kp ENTER            &kp SPACE            &kp RG(C)            &kp RG(V)            &kp RG(X)            &mo 2                &mo 1
                        >;
                };
                symbols_layer {
                        display-name = "Symbols";
                        bindings = <
&kp LS(N7)           &kp LS(N2)           &kp LS(N1)           &kp LS(LBKT)         &kp LS(RBKT)         &kp LS(BSLH)         &kp RG(C)            &kp KP_N7            &kp KP_N8            &kp KP_N9            &kp KP_PLUS          &kp KP_MINUS
&kp LC(X)            &kp LS(N3)           &kp LS(N4)           &kp LS(N9)           &kp LS(N0)           &kp GRAVE            &kp RG(X)            &kp KP_N4            &kp KP_N5            &kp KP_N6            &kp KP_ASTERISK      &kp KP_SLASH
&kp LSHFT            &kp LS(N5)           &kp LS(N6)           &kp LBKT             &kp RBKT             &kp LS(GRAVE)        &kp LC(Z)            &kp LC(Y)            &kp RG(V)            &kp KP_N1            &kp KP_N2            &kp KP_N3            &kp KP_DOT           &kp KP_EQUAL
&kp F11              &kp F12              &studio_unlock       &trans               &trans               &kp BSPC             &kp LGUI             &mo 3                &trans               &trans               &kp KP_N0            &kp RCTRL            &kp HOME             &kp END
                        >;
                };
                navigation_layer {
                        display-name = "Navigation";
                        bindings = <
&none                &none                &none                &none                &none                &none                &none                &none                &none                &none                &none                &none
&none                &kp LC(LA(F))        &kp LC(LA(LG(LEFT))) &kp LC(LA(LG(RIGHT))) &none                &none                &kp LEFT             &kp DOWN             &kp UP               &kp RIGHT            &none                &none
&kp LSHFT            &none                &none                &none                &none                &none                &none                &none                &none                &none                &none                &none                &none                &none
&none                &none                &none                &none                &none                &none                &kp LGUI             &none                &none                &none                &none                &none                &none                &none
                        >;
                };
                adjust_layer {
                        display-name = "Adjust";
                        bindings = <
&none                &none                &none                &none                &none                &none                &none                &kp PRINTSCREEN      &none                &none                &none                &none
&none                &none                &kp C_BRI_UP         &none                &none                &none                &none                &none                &none                &none                &none                &none
&bootloader          &none                &kp C_BRI_DN         &none                &none                &none                &bt BT_CLR           &none                &none                &none                &none                &none                &none                &none
&none                &none                &studio_unlock       &none                &none                &none                &trans               &trans               &none                &none                &none                &none                &none                &none
                        >;
                };
        };
};
